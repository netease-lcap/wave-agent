{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-warning-comments": [
      "error",
      {
        "terms": [
          "todo",
          "fixme",
          "hack",
          "bug",
          "eslint-disable",
          "eslint-disable-line",
          "eslint-disable-next-line"
        ]
      }
    ],
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": "error",
    "typescript/unbound-method": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-misused-spread": "off",
    "typescript/await-thenable": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/require-array-sort-compare": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:child_process",
            "importNames": [
              "execFile",
              "execFileSync",
              "exec",
              "execSync",
              "spawn",
              "spawnSync"
            ],
            "message": "子进程一律走 wrapper（utils/execFileHidden.ts）：短命令用 execFileHidden / execFileSyncHidden / execFileAsyncHidden / execAsyncHidden，常驻与流式进程用 spawnHidden / spawnSyncHidden。windowsHide 默认 false，宿主主进程没有控制台，漏一个 key 就是 Windows 上闪一次控制台窗口。"
          },
          {
            "name": "child_process",
            "importNames": [
              "execFile",
              "execFileSync",
              "exec",
              "execSync",
              "spawn",
              "spawnSync"
            ],
            "message": "子进程一律走 wrapper（utils/execFileHidden.ts）：短命令用 execFileHidden / execFileSyncHidden / execFileAsyncHidden / execAsyncHidden，常驻与流式进程用 spawnHidden / spawnSyncHidden。windowsHide 默认 false，宿主主进程没有控制台，漏一个 key 就是 Windows 上闪一次控制台窗口。"
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "childProcess",
        "property": "execFile",
        "message": "改用 execFileHidden / execFileAsyncHidden（windowsHide 默认 false）"
      },
      {
        "object": "childProcess",
        "property": "execFileSync",
        "message": "改用 execFileSyncHidden（windowsHide 默认 false）"
      },
      {
        "object": "childProcess",
        "property": "exec",
        "message": "改用 execAsyncHidden（windowsHide 默认 false）"
      },
      {
        "object": "childProcess",
        "property": "spawn",
        "message": "改用 spawnHidden（windowsHide 默认 false；同时把未声明的 fd0 指到 /dev/null）"
      },
      {
        "object": "childProcess",
        "property": "spawnSync",
        "message": "改用 spawnSyncHidden（windowsHide 默认 false；同时把未声明的 fd0 指到 /dev/null）"
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/globals": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "off",
    "react/immutability": "off",
    "react/static-components": "off",
    "react/incompatible-library": "off",
    "react/preserve-manual-memoization": "off"
  },
  "overrides": [
    {
      "files": [
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": [
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/examples/**/*",
        "**/fixtures/**/*",
        "**/e2e/**/*",
        "**/demo/**/*",
        "**/scripts/**/*"
      ],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-implied-eval": "off"
      }
    },
    {
      "files": [
        "**/fixtures/**/*",
        "**/e2e/**/*",
        "**/demo/**/*",
        "**/scripts/**/*"
      ],
      "rules": {
        "no-console": "off",
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": [
        "**/src/utils/execFileHidden.ts",
        "**/remote/build.mjs",
        "**/tests/**/*",
        "**/e2e/**/*",
        "**/scripts/**/*",
        "**/examples/**/*"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off"
      }
    }
  ]
}
