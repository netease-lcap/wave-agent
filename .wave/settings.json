{
  "env": {
    "WAVE_MAX_INPUT_TOKENS": "200000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(pnpm*)",
      "Bash(*.specify/scripts/bash/*)",
      "Bash(mkdir*)",
      "Bash(npx tsx*)",
      "Bash(sleep*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(npm*)",
      "Bash(touch*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(node packages/code/dist/index.js *)",
      "Bash(wave *)",
      "Bash(acpx *)",
      "Bash(rm *packages/*/tests/*)",
      "Bash(node scripts*)",
      "Bash(git fetch*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "additionalDirectories": ["~/github/claude-code", "~/github/claude-ai"]
  },
  "enabledPlugins": {
    "sdd@builtin": true
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .wave/hooks/worktree-create.mjs"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .wave/hooks/worktree-remove.mjs"
          }
        ]
      }
    ]
  }
}
