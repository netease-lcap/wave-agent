{
  "env": {
    "WAVE_CONTEXT_WINDOW": "200000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(pnpm*)",
      "Bash(mkdir*)",
      "Bash(npx tsx*)",
      "Bash(sleep*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(npm*)",
      "Bash(touch*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(rm *packages/*/tests/*)",
      "Bash(node scripts*)",
      "Bash(git fetch*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ]
  },
  "enabledPlugins": {
    "sdd@builtin": true
  }
}
