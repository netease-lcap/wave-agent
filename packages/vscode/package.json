{
  "name": "wave-vscode",
  "private": true,
  "displayName": "Wave Code Chat",
  "description": "Wave 代码智聊",
  "version": "1.1.5",
  "publisher": "wave-codechat",
  "icon": "LOGO.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/netease-lcap/wave-agent.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.107.0"
  },
  "files": [
    "dist/",
    "webview/dist/",
    "LOGO.png",
    "logo.svg",
    "LICENSE"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "views": {
      "waveChatView": [
        {
          "id": "waveChat",
          "name": "代码智聊",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "waveChatView",
          "title": "Wave",
          "icon": "logo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "wave-code.openChatSidebar",
        "title": "在侧边栏打开代码智聊",
        "category": "Wave"
      },
      {
        "command": "wave-code.openChatTab",
        "title": "在新标签页打开代码智聊",
        "category": "Wave"
      },
      {
        "command": "wave-code.openChatWindow",
        "title": "在新窗口打开代码智聊",
        "category": "Wave"
      },
      {
        "command": "wave-code.focusView",
        "title": "聚焦到聊天输入框",
        "category": "Wave"
      },
      {
        "command": "wave-code.addToWave",
        "title": "添加到 Wave",
        "category": "Wave"
      },
      {
        "command": "wave-code.openSettings",
        "title": "打开设置",
        "category": "Wave"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "wave-code.addToWave",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm run compile",
    "lint": "oxlint",
    "format": "prettier --write .",
    "clean": "node -e \"import('fs').then(fs => ['dist', 'webview/dist'].forEach(d => {try{fs.rmSync(d, {recursive:true, force:true})}catch(e){}}))\"",
    "prepackage": "pnpm run clean",
    "compile": "pnpm run compile:backend && pnpm run sync:webview && node scripts/bundleCli.mjs",
    "watch": "pnpm run watch:backend",
    "compile:backend": "node esbuild.config.mjs",
    "watch:backend": "node esbuild.config.mjs --watch",
    "sync:webview": "node scripts/syncWebview.mjs",
    "esbuild:prod": "node esbuild.config.mjs --production && node scripts/syncWebview.mjs --production && node scripts/bundleCli.mjs",
    "package": "node scripts/package.mjs",
    "type-check": "tsc --noEmit --incremental && tsc -p tests --noEmit --incremental",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "preinstall:vsix": "pnpm run package",
    "install:vsix": "code --install-extension releases/*.vsix",
    "push:tag": "git push origin $(git describe --tags --abbrev=0)"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "semver": "^7.7.4",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "wave-agent-sdk": "workspace:*",
    "wave-webview": "workspace:*",
    "wave-webview-fixtures": "workspace:*"
  }
}
