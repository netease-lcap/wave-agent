{
  "name": "wave-agent-sdk",
  "version": "1.5.1",
  "description": "SDK for building AI-powered development tools and agents",
  "keywords": [
    "ai",
    "sdk",
    "agent",
    "development-tools",
    "typescript",
    "mcp"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/netease-lcap/wave-agent.git",
    "directory": "packages/agent-sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude 'tests/integration/**' --exclude '**/*.integration.test.ts'",
    "test:unit:coverage": "vitest run --coverage --exclude 'tests/integration/**' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/integration .integration.test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@vscode/ripgrep": "^1.18.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "ajv": "^8.20.0",
    "chokidar": "^4.0.3",
    "cron-parser": "^5.5.0",
    "fflate": "^0.8.3",
    "fuzzysort": "^3.1.0",
    "glob": "^13.0.0",
    "lru-cache": "^11.3.5",
    "marked": "^17.0.2",
    "minimatch": "^10.0.3",
    "openai": "^7.45.1",
    "semver": "^7.7.4",
    "sharp": "^0.35.4",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.7",
    "rimraf": "^6.1.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
