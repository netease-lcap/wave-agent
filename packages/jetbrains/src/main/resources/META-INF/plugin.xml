<idea-plugin>
    <id>com.wave.jetbrains</id>
    <name>CodeWave IDE</name>
    <vendor>wave-codechat</vendor>

    <description><![CDATA[
        CodeWave IDE — an enterprise-grade AI coding assistant for JetBrains IDEs.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- @terminal 读 Shell 终端 widget 的文本缓冲（spec ui/ide-context-mentions.md） -->
    <depends>org.jetbrains.plugins.terminal</depends>
    <!--
      JCEF 自 2026.2 起从平台核心拆分为独立 bundled 插件（IJPL-246446）。
      - 2026.2+：声明该依赖后 JBCefBrowser 才对插件类加载器可见；
      - 2024.2–2026.1：插件不存在，optional 依赖被忽略，JCEF 类仍由
        平台核心的 app-client.jar 提供，插件照常工作。
    -->
    <depends optional="true" config-file="jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
            serviceImplementation="com.wave.jetbrains.WavePanelHolder"/>
        <projectService
            serviceImplementation="com.wave.jetbrains.WaveBackendService"/>
        <!-- Next-edit suggestions (spec ui/next-edit-suggestion.md). Project-scoped
             because it listens to every document of the project and owns the one
             visible preview popup; it stays quiet until a chat session exists. -->
        <projectService
            serviceImplementation="com.wave.jetbrains.nextEdit.WaveNextEditService"/>
        <!-- Project services are lazy: without this the service is never instantiated, its
             document listener never registers, and no edit ever enters the trajectory. -->
        <postStartupActivity
            implementation="com.wave.jetbrains.nextEdit.NextEditStartupActivity"/>
        <!-- The single chat panel renders as the side-bar Wave tool window content (cannot be
             closed; its title comes from toolWindow.title). ExitPlanMode plans render in a
             separate editor-area tab (WavePlanFileEditorProvider serves WavePlanVirtualFile),
             mirroring VSCE's chat panel + createWebviewPanel plan preview. The settings webview
             likewise renders in an editor-area tab (WaveSettingsFileEditor serves
             WaveSettingsVirtualFile), mirroring VSCE's settings panel. -->
        <toolWindow
            id="Wave"
            anchor="right"
            factoryClass="com.wave.jetbrains.WaveToolWindowFactory"
            icon="com.wave.jetbrains.icons.WaveIcons.Wave"/>
        <fileEditorProvider implementation="com.wave.jetbrains.editor.WavePlanFileEditorProvider"/>
        <editorTabTitleProvider implementation="com.wave.jetbrains.editor.WavePlanEditorTabTitleProvider"/>
        <fileEditorProvider implementation="com.wave.jetbrains.editor.WaveSettingsFileEditorProvider"/>
        <editorTabTitleProvider implementation="com.wave.jetbrains.editor.WaveSettingsEditorTabTitleProvider"/>
        <notificationGroup id="Wave" displayType="BALLOON"/>
        <iconMapper mappingFile="WavePluginIconMappings.json"/>
        <!-- Ghost-text completion (2024.2+). The provider reads the completion
             model off the chat session inside the CLI, so it stays quiet until a
             session exists. -->
        <inline.completion.provider
            implementation="com.wave.jetbrains.completion.WaveInlineCompletionProvider"/>
    </extensions>

    <actions>
        <action
            id="com.wave.jetbrains.openWave"
            class="com.wave.jetbrains.actions.OpenWaveToolWindowAction"
            text="Open CodeWave IDE"
            description="Open the CodeWave IDE tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.wave.jetbrains.openWaveSettings"
            class="com.wave.jetbrains.actions.OpenWaveSettingsAction"
            text="CodeWave IDE: 打开设置"
            description="Open the CodeWave IDE settings tab in the editor area">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.wave.jetbrains.addSelectionToWave"
            class="com.wave.jetbrains.actions.AddSelectionToWaveAction"
            text="Add Selection to CodeWave IDE"
            description="Insert the current editor selection into the CodeWave IDE chat input">
            <override-text place="EditorPopupMenu" text="Add to CodeWave IDE"/>
        </action>
        <group id="WaveEditorPopupMenu" text="CodeWave IDE" popup="true">
            <reference ref="com.wave.jetbrains.addSelectionToWave"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
        <!-- Next-edit accept: the popup's own Tab binding only works while the popup holds
             focus, so the same action is also a rebindable IDE action (Ctrl+Alt+Enter, as in
             VS Code). It is a no-op when nothing is showing. -->
        <action
            id="com.wave.jetbrains.nextEdit.accept"
            class="com.wave.jetbrains.nextEdit.AcceptNextEditAction"
            text="CodeWave IDE: 接受下一步编辑建议"
            description="Apply the next-edit suggestion currently shown">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt ENTER"/>
        </action>
    </actions>
</idea-plugin>
